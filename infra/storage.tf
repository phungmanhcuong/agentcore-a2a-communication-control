# Code bucket (the zip and the per-agent peer maps) and the OpenRouter secret container.

# Skipped checkov checks (each with the reason): this is a short-lived test deployment that must leave nothing behind after destroy.
#   CKV_AWS_145 KMS CMK: a CMK is scheduled for deletion (7 to 30 days) and stays after destroy; the bucket holds a zip of public code and peer ARNs.
#   CKV_AWS_144 cross-region replication, CKV_AWS_18 access logging, CKV2_AWS_62 notifications: need a second bucket or region; no data worth it.
resource "aws_s3_bucket" "code" {
  #checkov:skip=CKV_AWS_145:no CMK, it would outlive destroy
  #checkov:skip=CKV_AWS_144:test bucket, no replication
  #checkov:skip=CKV_AWS_18:test bucket, no access log bucket
  #checkov:skip=CKV2_AWS_62:test bucket, no event consumers
  bucket        = local.bucket_name
  force_destroy = true # objects (zip, peer maps) must not block destroy
}

resource "aws_s3_bucket_versioning" "code" {
  bucket = aws_s3_bucket.code.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "code" {
  bucket = aws_s3_bucket.code.id

  rule {
    id     = "expire-test-objects"
    status = "Enabled"

    filter {}

    abort_incomplete_multipart_upload {
      days_after_initiation = 1
    }

    expiration {
      days = 7
    }

    noncurrent_version_expiration {
      noncurrent_days = 1
    }
  }

  depends_on = [aws_s3_bucket_versioning.code]
}

resource "aws_s3_bucket_public_access_block" "code" {
  bucket                  = aws_s3_bucket.code.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "code" {
  bucket = aws_s3_bucket.code.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_object" "code" {
  bucket = aws_s3_bucket.code.id
  key    = "code/agent.zip"
  source = var.code_zip_path
  etag   = filemd5(var.code_zip_path)
}

# One peer map per agent: ONLY the peers team.yaml allows it to call (name -> runtime ARN). Written after the runtimes exist, so no
# runtime environment variable refers to another runtime (no dependency cycle between mutually allowed agents).
resource "aws_s3_object" "peers" {
  for_each     = local.agents
  bucket       = aws_s3_bucket.code.id
  key          = "peers/${each.key}.json"
  content_type = "application/json"
  content      = jsonencode({ for p in local.peers[each.key] : p => aws_bedrockagentcore_agent_runtime.agent[p].agent_runtime_arn })
}

# The secret CONTAINER only. The value is set in phase 2 outside Terraform (aws secretsmanager put-secret-value --secret-string file://...),
# so it never enters Terraform state. recovery_window_in_days = 0 deletes it at once on destroy.
resource "aws_secretsmanager_secret" "openrouter" {
  #checkov:skip=CKV_AWS_149:no CMK, it would outlive destroy; the default AWS-managed key encrypts the secret
  #checkov:skip=CKV2_AWS_57:rotation of a third-party key is manual; the secret lives for hours
  name                    = local.secret_name
  description             = "OpenRouter API key for the agent teams (value set out of band)"
  recovery_window_in_days = 0
}

# Per-deployment run token: every peer call and every entry call must carry it in X-Act-Token (src/act_teams/server.py allow_check).
# It stops a caller that AWS layer 2 does not cover (the account root user) from claiming a team name: root without the token is refused.
# It proves team membership, not which agent calls; identity is bound only by AWS layers 1 and 2 (IAM principal).
# The value is generated here, so it IS in Terraform state (local state in the shared area, never committed) and in this secret; it is NOT
# in any runtime environment variable (the runtimes get only the secret's name). It dies with `terraform destroy` (no recovery window).
resource "random_password" "run_token" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "run_token" {
  #checkov:skip=CKV_AWS_149:no CMK, it would outlive destroy; the default AWS-managed key encrypts the secret
  #checkov:skip=CKV2_AWS_57:the token lives for the deployment only; rotation is a redeploy
  name                    = local.token_secret
  description             = "Run token for the agent teams (generated by Terraform, one per deployment)"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "run_token" {
  secret_id     = aws_secretsmanager_secret.run_token.id
  secret_string = random_password.run_token.result
}
